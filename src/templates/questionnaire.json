{
  "version": "2.0.0",
  "template": "email-agent-generator",
  "language": "pl",
  "description": "Kwestionariusz do wygenerowania agenta mailowego w n8n dla dowolnego biznesu.",
  "sections": [
    {
      "id": "business_profile",
      "title": "Profil biznesu",
      "questions": [
        {
          "id": "business_name",
          "type": "text",
          "label": "Nazwa firmy",
          "required": true
        },
        {
          "id": "language_primary",
          "type": "select",
          "label": "Główny język odpowiedzi",
          "required": true,
          "options": ["pl", "en", "de", "fr", "es"]
        },
        {
          "id": "brand_tone",
          "type": "select",
          "label": "Ton komunikacji",
          "required": true,
          "options": ["formal", "semi_formal", "informal"]
        },
        {
          "id": "email_signature",
          "type": "textarea",
          "label": "Stopka maila (wklej jak chcesz żeby wyglądała — imię, stanowisko, firma, telefon, www itp.)",
          "required": true,
          "placeholder": "Jan Kowalski\nDyrektor Sprzedaży\nFirma ABC Sp. z o.o.\ntel. +48 500 000 000\nwww.firma.pl"
        }
      ]
    },
    {
      "id": "channels_and_tools",
      "title": "Kanały i narzędzia",
      "questions": [
        {
          "id": "email_inbox_address",
          "type": "text",
          "label": "Adres skrzynki obsługiwanej przez agenta",
          "required": true,
          "placeholder": "kontakt@firma.pl"
        },
        {
          "id": "approval_channel",
          "type": "select",
          "label": "Kanał akceptacji draftu",
          "required": true,
          "options": ["google_chat", "none"]
        },
        {
          "id": "google_chat_space_id",
          "type": "text",
          "label": "Google Chat Space ID (wymagane przy wyborze Google Chat, np. spaces/AAQAuUSheK4)",
          "required": false,
          "placeholder": "spaces/XXXXXXXXXX"
        },
        {
          "id": "airtable_base_id",
          "type": "text",
          "label": "Airtable Base ID (znajdziesz w URL bazy: airtable.com/appXXX...)",
          "required": true,
          "placeholder": "appXXXXXXXXXXXXXX"
        },
        {
          "id": "webhook_prefix",
          "type": "text",
          "label": "Unikalny prefix webhooka (tylko litery, cyfry, myślnik — np. moja-firma)",
          "required": true,
          "placeholder": "moja-firma"
        }
      ]
    },
    {
      "id": "intent_routing",
      "title": "Intencje i routing",
      "questions": [
        {
          "id": "intents",
          "type": "array",
          "label": "Lista intencji — co agent ma rozpoznawać i jak obsługiwać",
          "required": true,
          "item_schema": {
            "name": "string",
            "description": "string",
            "route_key": "string",
            "auto_reply_enabled": "boolean",
            "requires_approval": "boolean"
          },
          "default": [
            {
              "name": "new_inquiry",
              "description": "Nowe zapytanie od klienta",
              "route_key": "new_inquiry",
              "auto_reply_enabled": true,
              "requires_approval": true
            },
            {
              "name": "follow_up",
              "description": "Kontynuacja rozmowy, przypomnienie",
              "route_key": "follow_up",
              "auto_reply_enabled": true,
              "requires_approval": true
            },
            {
              "name": "formalnosci",
              "description": "Sprawy dokumentowe i formalne — potwierdzenie odbioru",
              "route_key": "formalnosci",
              "auto_reply_enabled": true,
              "requires_approval": true
            },
            {
              "name": "ignore",
              "description": "Spam, systemowe, niebiznesowe — brak odpowiedzi",
              "route_key": "ignore",
              "auto_reply_enabled": false,
              "requires_approval": false
            }
          ]
        },
        {
          "id": "label_mapping",
          "type": "array",
          "label": "Mapowanie intencji na etykiety Gmail (opcjonalne — jeśli chcesz auto-tagowania)",
          "required": false,
          "item_schema": {
            "intent": "string",
            "label_id": "string"
          }
        }
      ]
    },
    {
      "id": "knowledge_and_policy",
      "title": "Baza wiedzy i polityka odpowiedzi",
      "questions": [
        {
          "id": "must_follow_rules",
          "type": "textarea",
          "label": "Reguły, które agent MUSI stosować (zasady odpowiadania, czego unikać, jak się zachowywać)",
          "required": true,
          "placeholder": "- Odpowiadaj profesjonalnie i zwięźle (3-5 zdań)\n- Nie podawaj cen bez potwierdzenia z cennikiem\n- Nie obiecuj terminów bez konsultacji z zespołem\n- Maksymalnie 2 pytania doprecyzujące w jednej odpowiedzi"
        },
        {
          "id": "pricing_and_offer_policy",
          "type": "textarea",
          "label": "Informacje o ofercie i cenniku (co agent ma wiedzieć o Twojej usłudze/produkcie)",
          "required": true
        },
        {
          "id": "forbidden_phrases",
          "type": "array_text",
          "label": "Zwroty zakazane (których agent nie może używać)",
          "required": false
        },
        {
          "id": "knowledge_base_entries",
          "type": "array",
          "label": "Baza wiedzy / FAQ (dodatkowe tematy i materiały dla agenta)",
          "required": false,
          "item_schema": {
            "topic": "string",
            "content_markdown": "textarea"
          },
          "default": []
        }
      ]
    }
  ]
}
