{
  "name": "[WORKFLOW] Feedback Loop",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "schema": [
            { "name": "draft_id", "type": "string", "displayName": "Draft ID", "required": true },
            { "name": "feedback_text", "type": "string", "displayName": "Feedback Text", "required": true },
            { "name": "corrected_by", "type": "string", "displayName": "Corrected By (email)", "required": true }
          ]
        }
      },
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "search",
        "base": "app5NIUbshNL31ylr",
        "table": "Draft_Queue",
        "filterByFormula": "={draft_id} = '{{ $json.draft_id }}'",
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "name": "Get Original Draft",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [460, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "value": "[AGENT] Response Generator",
          "mode": "name"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "template_type": "={{ JSON.parse($('Get Original Draft').item.json.classification || '{}').intent || '' }}",
            "context": "={{ $('Get Original Draft').item.json.context }}",
            "tone": "={{ JSON.parse($('Get Original Draft').item.json.classification || '{}').detected_tone || '' }}",
            "previous_draft": "={{ $('Get Original Draft').item.json.draft_body }}",
            "correction_feedback": "={{ $('Execute Workflow Trigger').item.json.feedback_text }}"
          }
        },
        "mode": "each"
      },
      "name": "Regenerate with Feedback",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "delete",
        "draftId": "={{ $('Get Original Draft').item.json.draft_gmail_id }}",
        "options": { "continueOnFail": true }
      },
      "name": "Delete Old Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [900, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ $('Get Original Draft').item.json.draft_subject || $('Get Original Draft').item.json.email_subject }}",
        "message": "={{ $('Regenerate with Feedback').item.json.draft_body }}",
        "options": {
          "sendTo": "={{ $('Get Original Draft').item.json.email_from }}"
        }
      },
      "name": "Create New Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1120, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "base": "app5NIUbshNL31ylr",
        "table": "Draft_Corrections",
        "fields": {
          "correction_id": "={{ $execution.id }}",
          "draft_id": "={{ $('Get Original Draft').item.json.draft_id }}",
          "original_draft": "={{ $('Get Original Draft').item.json.draft_body }}",
          "feedback_text": "={{ $('Execute Workflow Trigger').item.json.feedback_text }}",
          "corrected_draft": "={{ $('Regenerate with Feedback').item.json.draft_body }}",
          "correction_type": "manual",
          "classification_intent": "={{ JSON.parse($('Get Original Draft').item.json.classification || '{}').intent || '' }}",
          "classification_tone": "={{ JSON.parse($('Get Original Draft').item.json.classification || '{}').detected_tone || '' }}",
          "corrected_by": "={{ $('Execute Workflow Trigger').item.json.corrected_by }}",
          "pattern_analyzed": false
        },
        "options": {}
      },
      "name": "Save Correction to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1340, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "base": "app5NIUbshNL31ylr",
        "table": "Draft_Queue",
        "id": "={{ $('Get Original Draft').item.json.id }}",
        "fields": {
          "draft_body": "={{ $('Regenerate with Feedback').item.json.draft_body }}",
          "draft_gmail_id": "={{ $('Create New Gmail Draft').item.json.id }}",
          "edit_count": "={{ ($('Get Original Draft').item.json.edit_count || 0) + 1 }}",
          "status": "pending_approval"
        },
        "options": {}
      },
      "name": "Update Draft Queue",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1560, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://chat.googleapis.com/v1/spaces/YOUR_GOOGLE_CHAT_SPACE_ID/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleChatOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  text: '🔄 **DRAFT ZAKTUALIZOWANY**\\n\\nFeedback zastosowany: ' + $('Execute Workflow Trigger').item.json.feedback_text + '\\n\\n📝 NOWY DRAFT:\\n---\\n' + $('Regenerate with Feedback').item.json.draft_body + '\\n---\\n\\nDraft ID: ' + $('Get Original Draft').item.json.draft_id,\n  cardsV2: [{\n    cardId: 'approval-card-v2',\n    card: {\n      sections: [{\n        widgets: [{\n          buttonList: {\n            buttons: [\n              { text: '✅ Approve & Send', onClick: { action: { function: 'approve_draft', parameters: [{ key: 'draft_id', value: $('Get Original Draft').item.json.draft_id }] } } },\n              { text: '✏️ Edit Again', onClick: { action: { function: 'edit_draft', parameters: [{ key: 'draft_id', value: $('Get Original Draft').item.json.draft_id }] } } },\n              { text: '❌ Reject', onClick: { action: { function: 'reject_draft', parameters: [{ key: 'draft_id', value: $('Get Original Draft').item.json.draft_id }] } } }\n            ]\n          }\n        }]\n      }]\n    }\n  }]\n}) }}",
        "options": {}
      },
      "name": "Send Updated Draft for Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "credentials": {
        "googleChatOAuth2Api": {
          "id": "YOUR_GOOGLE_CHAT_CREDENTIAL_ID",
          "name": "Google Chat OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [[{ "node": "Get Original Draft", "type": "main", "index": 0 }]]
    },
    "Get Original Draft": {
      "main": [[{ "node": "Regenerate with Feedback", "type": "main", "index": 0 }]]
    },
    "Regenerate with Feedback": {
      "main": [[{ "node": "Delete Old Gmail Draft", "type": "main", "index": 0 }]]
    },
    "Delete Old Gmail Draft": {
      "main": [[{ "node": "Create New Gmail Draft", "type": "main", "index": 0 }]]
    },
    "Create New Gmail Draft": {
      "main": [[{ "node": "Save Correction to Airtable", "type": "main", "index": 0 }]]
    },
    "Save Correction to Airtable": {
      "main": [[{ "node": "Update Draft Queue", "type": "main", "index": 0 }]]
    },
    "Update Draft Queue": {
      "main": [[{ "node": "Send Updated Draft for Approval", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [
    { "name": "workflow", "id": "5" },
    { "name": "feedback", "id": "6" }
  ],
  "pinData": {}
}
