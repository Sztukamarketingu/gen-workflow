{
  "name": "[PIPELINE] Approval Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "google-chat-approval",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Google Chat Action Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "google-chat-approval-webhook",
      "notes": "Receives POST callback from Google Chat card buttons"
    },
    {
      "parameters": {
        "jsCode": "// Parse action data from Google Chat webhook\nconst webhook = $input.first().json;\nconst action = webhook.action?.function || webhook.commonEventObject?.invokedFunction || 'unknown';\nconst params = webhook.action?.parameters || webhook.commonEventObject?.parameters || [];\n\nlet draft_id;\nif (Array.isArray(params)) {\n  const draftParam = params.find(p => p.key === 'draft_id');\n  draft_id = draftParam?.value;\n} else {\n  draft_id = params.draft_id;\n}\n\nconst user_email = webhook.user?.email || webhook.user?.name || 'unknown';\nconst user_name = webhook.user?.displayName || webhook.user?.name || 'Unknown User';\n\nreturn {\n  json: {\n    action: action.replace('_draft', ''),\n    draft_id,\n    user_email,\n    user_name,\n    raw_webhook: webhook\n  }\n};"
      },
      "name": "Parse Action Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "notes": "Extract action type and draft_id from webhook payload"
    },
    {
      "parameters": {
        "operation": "search",
        "base": "app5NIUbshNL31ylr",
        "table": "Draft_Queue",
        "filterByFormula": "={draft_id} = '{{ $json.draft_id }}'",
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "name": "Get Draft from Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      },
      "notes": "Fetch draft state from Airtable"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.action }}",
                    "operation": "equals",
                    "value2": "approve"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "approve"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.action }}",
                    "operation": "equals",
                    "value2": "edit"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "edit"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.action }}",
                    "operation": "equals",
                    "value2": "reject"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "reject"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.action }}",
                    "operation": "equals",
                    "value2": "submit_feedback"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "submit_feedback"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "name": "Route Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        900,
        300
      ],
      "notes": "Route to approve/edit/reject handler"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email_from }}",
        "subject": "={{ $json.draft_subject }}",
        "message": "={{ $json.draft_body }}",
        "options": {
          "threadId": "={{ $json.email_thread_id }}"
        }
      },
      "name": "APPROVE: Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1120,
        100
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      },
      "notes": "Send the approved draft email"
    },
    {
      "parameters": {
        "operation": "update",
        "base": "app5NIUbshNL31ylr",
        "table": "Draft_Queue",
        "id": "={{ $('Get Draft from Airtable').item.json.id }}",
        "fields": {
          "status": "sent",
          "approved_by": "={{ $('Parse Action Data').item.json.user_email }}",
          "approved_at": "={{ new Date().toISOString() }}",
          "sent_at": "={{ new Date().toISOString() }}"
        },
        "options": {}
      },
      "name": "APPROVE: Update Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        1340,
        100
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "text": "=✅ **EMAIL WYSŁANY**\n\nDo: {{ $('Get Draft from Airtable').item.json.email_from }}\nTemat: {{ $('Get Draft from Airtable').item.json.draft_subject }}\n\nWysłane przez: {{ $('Parse Action Data').item.json.user_name }}",
        "options": {}
      },
      "name": "APPROVE: Notify Success",
      "type": "n8n-nodes-base.googleChat",
      "typeVersion": 1,
      "position": [
        1560,
        100
      ],
      "credentials": {
        "googleChatOAuth2": {
          "id": "YOUR_GOOGLE_CHAT_CREDENTIAL_ID",
          "name": "Google Chat OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://chat.googleapis.com/v1/spaces/YOUR_GOOGLE_CHAT_SPACE_ID/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleChatOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  text: '✏️ **EDYCJA DRAFTU**\\n\\nCo chcesz poprawić w drafcie?\\n\\nAktualna treść:\\n---\\n' + $json.draft_body + '\\n---',\n  cardsV2: [{\n    cardId: 'feedback-form',\n    card: {\n      sections: [{\n        widgets: [\n          {\n            textInput: {\n              name: 'feedback',\n              label: 'Twój feedback',\n              type: 'MULTIPLE_LINE',\n              hintText: 'Opisz co poprawić (np. \"Zmień ton na bardziej formalny\", \"Dodaj informację o rabacie\")'\n            }\n          },\n          {\n            buttonList: {\n              buttons: [{\n                text: 'Submit Feedback',\n                onClick: {\n                  action: {\n                    function: 'submit_feedback',\n                    parameters: [{ key: 'draft_id', value: $json.draft_id }]\n                  }\n                }\n              }]\n            }\n          }\n        ]\n      }]\n    }\n  }]\n}) }}",
        "options": {}
      },
      "name": "EDIT: Show Feedback Form",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "credentials": {
        "googleChatOAuth2Api": {
          "id": "YOUR_GOOGLE_CHAT_CREDENTIAL_ID",
          "name": "Google Chat OAuth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "base": "app5NIUbshNL31ylr",
        "table": "Draft_Queue",
        "id": "={{ $json.id }}",
        "fields": {
          "status": "rejected",
          "approved_by": "={{ $json.user_email }}",
          "approved_at": "={{ new Date().toISOString() }}",
          "rejection_reason": "Odrzucone przez użytkownika"
        },
        "options": {}
      },
      "name": "REJECT: Update Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        1120,
        500
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "text": "=❌ **DRAFT ODRZUCONY**\n\nDo: {{ $('Get Draft from Airtable').item.json.email_from }}\nTemat: {{ $('Get Draft from Airtable').item.json.draft_subject }}\n\nOdrzucone przez: {{ $('Parse Action Data').item.json.user_name }}",
        "options": {}
      },
      "name": "REJECT: Notify",
      "type": "n8n-nodes-base.googleChat",
      "typeVersion": 1,
      "position": [
        1340,
        500
      ],
      "credentials": {
        "googleChatOAuth2": {
          "id": "YOUR_GOOGLE_CHAT_CREDENTIAL_ID",
          "name": "Google Chat OAuth2"
        }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "value": "[WORKFLOW] Feedback Loop",
          "mode": "name"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "draft_id": "={{ $('Get Draft from Airtable').item.json.draft_id }}",
            "feedback_text": "={{ $('Parse Action Data').item.json.raw_webhook?.commonEventObject?.formInputs?.feedback?.stringInputs?.value[0] || 'Brak danych' }}",
            "corrected_by": "={{ $('Parse Action Data').item.json.user_email }}"
          }
        },
        "mode": "each"
      },
      "name": "EDIT: Call Feedback Loop",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1120,
        700
      ],
      "notes": "Trigger the feedback loop sub-workflow"
    }
  ],
  "connections": {
    "Google Chat Action Webhook": {
      "main": [
        [
          {
            "node": "Parse Action Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Action Data": {
      "main": [
        [
          {
            "node": "Get Draft from Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Draft from Airtable": {
      "main": [
        [
          {
            "node": "Route Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Action": {
      "main": [
        [
          {
            "node": "APPROVE: Send Gmail",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "EDIT: Show Feedback Form",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "REJECT: Update Airtable",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "EDIT: Call Feedback Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "APPROVE: Send Gmail": {
      "main": [
        [
          {
            "node": "APPROVE: Update Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "APPROVE: Update Airtable": {
      "main": [
        [
          {
            "node": "APPROVE: Notify Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "REJECT: Update Airtable": {
      "main": [
        [
          {
            "node": "REJECT: Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "pipeline",
      "id": "2"
    },
    {
      "name": "approval",
      "id": "4"
    }
  ],
  "pinData": {}
}