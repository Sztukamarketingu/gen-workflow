      "parameters": {
        "jsCode": "const draft = $input.first().json;\nconst command = $('Parse Command Type').first().json;\n\nlet context = {};\nlet classification = {};\nlet responseGuidance = {};\ntry { context = JSON.parse(draft.context || '{}'); } catch(e) {}\ntry { classification = JSON.parse(draft.classification || '{}'); } catch(e) {}\n// response_guidance is now stored inside context\ntry { responseGuidance = context.response_guidance || {}; } catch(e) {}\n\nlet existingCorrections = [];\ntry { existingCorrections = JSON.parse(draft.corrections_history || '[]'); } catch(e) {}\n\nconst newCorrection = {\n  correction_number: existingCorrections.length + 1,\n  feedback_text: command.message_text,\n  timestamp: command.timestamp,\n  user: command.user\n};\n\nreturn [{\n  json: {\n    airtable_record_id: draft.id,\n    draft_id: draft.draft_id || '',\n    original_draft_subject: draft.draft_subject || '',\n    current_draft_body: draft.draft_body || '',\n    original_draft_body: draft.original_draft_body || draft.draft_body || '',\n    email_from: draft.email_from || '',\n    email_subject: draft.email_subject || '',\n    email_context: context,\n    classification: classification,\n    response_guidance: responseGuidance,\n    correction_feedback: command.message_text,\n    corrections_history: [...existingCorrections, newCorrection],\n    edit_count: (parseInt(draft.edit_count) || 0) + 1,\n    gmail_draft_id: draft.draft_gmail_id || '',\n    email_thread_id: draft.email_thread_id || '',\n    knowledge_context: context.knowledge_context || ''\n  }\n}];"
      },
