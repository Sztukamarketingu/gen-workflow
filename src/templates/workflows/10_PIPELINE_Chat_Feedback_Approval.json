    {
      "parameters": {
        "jsCode": "const corrected = $input.first().json;\nconst ctx = $('Build Correction Context').first().json;\n\n// Get corrected body from Response Generator output\nconst correctedBody = corrected.draft_body || corrected.response || corrected.text || ctx.current_draft_body;\n\n// Convert to HTML\nconst htmlBody = correctedBody\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .split('\\n\\n')\n  .map(p => `<p>${p.replace(/\\n/g, '<br>')}</p>`)\n  .join('');\n\nreturn [{\n  json: {\n    ...ctx,\n    corrected_draft_body: correctedBody,\n    corrected_draft_body_html: htmlBody,\n    corrected_draft_subject: ctx.original_draft_subject\n  }\n}];"
      },
