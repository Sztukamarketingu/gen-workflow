    {
      "parameters": {
        "jsCode": "// This node prepares data for the Response Generator sub-workflow\n// For now, we build a correction prompt that will be passed to AI\nconst ctx = $input.first().json;\n\nreturn [{\n  json: {\n    ...ctx,\n    ai_prompt: `Jesteś asystentem impresariatu koncertowego. Masz poprawić poniższy draft odpowiedzi mailowej zgodnie z instrukcją użytkownika.\\n\\nAKTUALNY DRAFT:\\n${ctx.current_draft_body}\\n\\nINSTRUKCJA KOREKTY:\\n${ctx.correction_feedback}\\n\\nKONTEKST MAILA:\\nOd: ${ctx.email_from}\\nTemat: ${ctx.email_subject}\\n\\nZwróć TYLKO poprawioną treść maila, bez dodatkowych komentarzy.`\n  }\n}];"
      },
