{
  "name": "[PIPELINE] Chat Feedback & Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "google-chat-approval",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Chat Feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        304
      ],
      "webhookId": "chat-feedback-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst eventType = body.type || '';\n\n// Ignore system events (REST API format)\nif ([\"ADDED_TO_SPACE\", \"VERIFICATION\", \"REMOVED_FROM_SPACE\"].includes(eventType)) {\n  return [{ json: { command_type: \"ignore\", message_text: \"\", timestamp: new Date().toISOString() } }];\n}\n\n// Support both Google Chat App (REST API) and Google Workspace Add-on (GCAA) formats\n// REST API: message at body.message\n// Add-on:   message at body.chat.messagePayload.message\nconst chatMessage = body.message || body.chat?.messagePayload?.message || {};\nconst chatUser = body.user || body.chat?.user || {};\nconst chatSpace = body.space || body.chat?.messagePayload?.space || {};\n\n// Ignore bot messages (prevent echo loop)\nconst senderType = chatMessage.sender?.type || chatUser.type || \"\";\nif (senderType === \"BOT\") {\n  return [{ json: { command_type: \"ignore\", message_text: \"\", timestamp: new Date().toISOString() } }];\n}\n\n// Also ignore if no message (ping/verification)\nif (!chatMessage || Object.keys(chatMessage).length === 0) {\n  return [{ json: { command_type: \"ignore\", message_text: \"\", timestamp: new Date().toISOString() } }];\n}\n\n// argumentText = text WITHOUT @mention prefix (user typed after @Asystent)\nconst message = (chatMessage.argumentText || chatMessage.text || \"\").trim();\nconst msgLower = message.toLowerCase();\n\nconst approvalKeywords = [\"ok\", \"wyślij\", \"wyslij\", \"zatwierdź\", \"zatwierdz\", \"zatwierdzam\", \"send\", \"approve\", \"tak\", \"dobrze\"];\nconst rejectKeywords = [\"odrzuć\", \"odrzuc\", \"anuluj\", \"nie\", \"reject\"];\n\nconst isApproval = approvalKeywords.some(kw => msgLower === kw || msgLower === kw + \"!\" || msgLower === kw + \".\");\nconst isReject = rejectKeywords.some(kw => msgLower === kw || msgLower === kw + \"!\" || msgLower === kw + \".\");\n\nlet command_type = \"ignore\";\nif (isApproval) command_type = \"approval\";\nelse if (isReject) command_type = \"rejection\";\nelse if (message.length > 2) command_type = \"correction\";\n\nreturn [{\n  json: {\n    command_type,\n    message_text: message,\n    message_id: chatMessage.name || \"\",\n    user: chatMessage.sender?.displayName || chatUser.displayName || \"\",\n    space: chatSpace.name || \"\",\n    thread_name: chatMessage.thread?.name || \"\",\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
