      "parameters": {
        "jsCode": "const data = $('Prepare Send Data').first().json;\n\nconst embeddingText = [\n  `Email od: ${data.email_from}`,\n  `Temat: ${data.email_subject}`,\n  `Intent: ${data.classification?.intent || 'unknown'}`,\n  `Ton: ${data.classification?.detected_tone || 'unknown'}`,\n  `Rola nadawcy: ${data.classification?.sender_role || 'unknown'}`,\n  '',\n  'Pierwotny draft AI:',\n  data.original_draft_body,\n  '',\n  data.corrections_count > 0 ? `Poprawki (${data.corrections_count}):` : '',\n  data.corrections_count > 0 ? data.corrections_history.map((c, i) => `${i+1}. ${c.feedback_text}`).join('\\n') : '',\n  '',\n  'Zatwierdzona wersja:',\n  data.final_draft_body\n].filter(Boolean).join('\\n').trim();\n\nreturn [{\n  json: {\n    ...data,\n    embedding_text: embeddingText,\n    pinecone_metadata: {\n      draft_id: data.draft_id,\n      intent: data.classification?.intent || '',\n      sender_role: data.classification?.sender_role || '',\n      tone: data.classification?.detected_tone || '',\n      corrections_count: data.corrections_count,\n      edit_count: data.edit_count,\n      timestamp: new Date().toISOString(),\n      event_type: data.email_context?.event_type || '',\n      had_corrections: data.had_corrections,\n      original_draft: (data.original_draft_body || '').substring(0, 500),\n      final_draft: (data.final_draft_body || '').substring(0, 500),\n      corrections_summary: data.corrections_history.map(c => c.feedback_text).join(' | ').substring(0, 300)\n    }\n  }\n}];"
      },
