      "parameters": {
        "jsCode": "const draft = $('Get Pending Draft (Approval)').first().json;\n\nlet context = {};\nlet classification = {};\nlet correctionsHistory = [];\ntry { context = JSON.parse(draft.context || '{}'); } catch(e) {}\ntry { classification = JSON.parse(draft.classification || '{}'); } catch(e) {}\ntry { correctionsHistory = JSON.parse(draft.corrections_history || '[]'); } catch(e) {}\n\n// Extract clean email address\nconst fromText = draft.email_from || '';\nconst emailMatch = fromText.match(/<([^>]+)>/);\nconst cleanEmail = (emailMatch && emailMatch[1]) ? emailMatch[1] : fromText.replace(/^\"|\"$/g, '').trim();\n\nreturn [{\n  json: {\n    airtable_record_id: draft.id,\n    draft_id: draft.draft_id || '',\n    gmail_draft_id: draft.draft_gmail_id || '',\n    email_thread_id: draft.email_thread_id || '',\n    email_from: draft.email_from || '',\n    email_from_clean: cleanEmail,\n    email_subject: draft.email_subject || '',\n    final_draft_subject: draft.draft_subject || '',\n    final_draft_body: draft.draft_body || '',\n    original_draft_body: draft.original_draft_body || draft.draft_body || '',\n    corrections_count: correctionsHistory.length,\n    corrections_history: correctionsHistory,\n    email_context: context,\n    classification: classification,\n    edit_count: parseInt(draft.edit_count) || 0,\n    had_corrections: correctionsHistory.length > 0\n  }\n}];"
