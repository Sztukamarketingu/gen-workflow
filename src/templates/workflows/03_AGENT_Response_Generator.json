{
  "name": "[AGENT] Response Generator",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "schema": [
            {
              "name": "template_type",
              "type": "string",
              "displayName": "Template Type",
              "required": true
            },
            {
              "name": "context",
              "type": "json",
              "displayName": "Context Data",
              "required": true
            },
            {
              "name": "response_guidance",
              "type": "json",
              "displayName": "Response Guidance",
              "required": false
            },
            {
              "name": "artists",
              "type": "json",
              "displayName": "Artists Data",
              "required": false
            },
            {
              "name": "tone",
              "type": "string",
              "displayName": "Tone",
              "required": false,
              "default": "semi_formal"
            },
            {
              "name": "previous_draft",
              "type": "string",
              "displayName": "Previous Draft (for corrections)",
              "required": false
            },
            {
              "name": "correction_feedback",
              "type": "string",
              "displayName": "Correction Feedback",
              "required": false
            },
            {
              "name": "knowledge_context",
              "type": "string",
              "displayName": "Knowledge Base (reguły)",
              "required": false
            }
          ]
        }
      },
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "id": "trigger-response-generator"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=// UWAGA: Wklej tutaj treść promptu z pliku prompts/AI_Response_Generator.txt\n// Zmienne dostępne w wyrażeniach:\n//   {{ $('Execute Workflow Trigger').first().json.template_type }}\n//   {{ JSON.stringify($('Execute Workflow Trigger').first().json.context) }}\n//   {{ JSON.stringify($('Execute Workflow Trigger').first().json.response_guidance) }}\n//   {{ JSON.stringify($('Execute Workflow Trigger').first().json.artists) }}\n//   {{ $('Execute Workflow Trigger').first().json.tone }}\n//   {{ $('Execute Workflow Trigger').first().json.previous_draft }}\n//   {{ $('Execute Workflow Trigger').first().json.correction_feedback }}\n//   {{ $('Execute Workflow Trigger').first().json.knowledge_context }}\n//\n// Model zwróci czysty JSON (bez markdown), np.:\n// { \"draft_subject\": \"RE: ...\", \"draft_body\": \"Dzień dobry,...\" }\n\nZASTĄP TEN KOMENTARZ TREŚCIĄ PROMPTU Z PLIKU prompts/AI_Response_Generator.txt"
      },
      "name": "AI Response Generator",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [460, 300],
      "id": "ai-response-generator"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 1500,
          "responseFormat": "json_object"
        }
      },
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.1,
      "position": [460, 500],
      "id": "openai-model-response-generator",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// chainLlm z JSON mode zwraca czysty JSON w polu .text — bez regex, bez fallback\nconst parsed = JSON.parse($input.first().json.text || '{}');\nreturn { json: parsed };"
      },
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "parse-response"
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [{ "node": "AI Response Generator", "type": "main", "index": 0 }]
      ]
    },
    "AI Response Generator": {
      "main": [
        [{ "node": "Parse Response", "type": "main", "index": 0 }]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [{ "node": "AI Response Generator", "type": "ai_languageModel", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "agent", "id": "1" }
  ],
  "pinData": {}
